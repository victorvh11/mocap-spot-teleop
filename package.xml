<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_mocap_teleop</name>
  <version>1.0.0</version>
  <description>Teleoperation of Spot robot arm via OptiTrack motion capture glove</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS2 -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>builtin_interfaces</depend>

  <!-- MOCAP4ROS2 -->
  <depend>mocap4r2_msgs</depend>

  <!-- Spot ROS2 -->
  <depend>spot_driver</depend>
  <depend>spot_msgs</depend>
  <depend>bosdyn_msgs</depend>

  <!-- Rosbag -->
  <depend>rosbag2_py</depend>
  <depend>rosbag2_transport</depend>

  <!-- Python deps -->
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <depend>python3-transforms3d</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
